# Compute predicted elongation speed v(tss) and elongation time for various tss
import numpy as np
import pandas as pd

# Parameters (corrigidos)
n = 10.5                 # bp per turn
Lambda_s_Topo = 1.0      # s^-1 (Topo I específico upstream)  ← alterado de 1.4 para 1.0
lambda_ns_Topo = 1e-4    # s^-1 por bp (Topo I não específico upstream)
Lambda_s_Gyr = 2.5       # Lk/s (gyrase específico downstream)
vmax = 25.0              # bp/s (velocidade máxima da RNAP)
f = 1.0                  # fração de tempo ativo do TopoI específico

# Limites derivados
v_cap_gyr = n * Lambda_s_Gyr   # bp/s

def R_up(tss_bp):
    return f * Lambda_s_Topo + lambda_ns_Topo * tss_bp

def v_cycle(tss_bp):
    R = R_up(tss_bp)
    return (n * R) / (1.0 + (n / vmax) * R)

def v_pred(tss_bp):
    v = v_cycle(tss_bp)
    return min(v, vmax, v_cap_gyr)

# tss a avaliar
tss_values = [50, 100, 200, 300, 500, 750, 1000, 1500, 2000, 3000, 5000, 7500,
              10000, 15000, 20000, 30000, 50000]

gene_L = 900.0  # comprimento do gene para calcular T_elong

rows = []
for tss in tss_values:
    R = R_up(tss)
    v_cyc = v_cycle(tss)
    v_final = v_pred(tss)
    T_elong = gene_L / v_final
    rows.append({
        "tss_bp": tss,
        "R_up (1/s)": R,
        "v_cycle (bp/s)": v_cyc,
        "v_pred (bp/s)": v_final,
        "T_elong_for_900bp (s)": T_elong
    })

df = pd.DataFrame(rows)[["tss_bp", "R_up (1/s)", "v_cycle (bp/s)", "v_pred (bp/s)", "T_elong_for_900bp (s)"]]
df_rounded = df.copy()
df_rounded["R_up (1/s)"] = df_rounded["R_up (1/s)"].round(4)
df_rounded["v_cycle (bp/s)"] = df_rounded["v_cycle (bp/s)"].round(3)
df_rounded["v_pred (bp/s)"] = df_rounded["v_pred (bp/s)"].round(3)
df_rounded["T_elong_for_900bp (s)"] = df_rounded["T_elong_for_900bp (s)"].round(3)

# Apenas imprimir a tabela
print(df_rounded.to_string(index=False))




