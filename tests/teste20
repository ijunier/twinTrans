import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# --- Dados de simulação (exemplo) ---
data = [
    ("kb",     0.010, 112.563088),
    ("kb",     0.453,  83.320568),
    ("kb",   100.000,  82.890564),
    ("ke",     0.010,  80.036460),
    ("ke",    10.000,  82.811432),
    ("ko",     0.010,  80.169580),
    ("ko",   100.000,  83.420148),
    ("nsgyrase",1e-6,  79.606184),
    ("nstopo1", 1e-6,  90.890096),
    ("sgyrase", 0.020,1251.418612),
    ("stopo1",  0.010, 779.104032),
    ("tss",   100.000,109.763228),
    ("tss",  5000.000, 66.977648),
]
df = pd.DataFrame(data, columns=['param','value','elong_time_sim'])

# --- Parâmetros default do modelo ---
L      = 900.0    # comprimento do gene (bp)
Ld     = 520.0    # downstream (bp)
v_max  = 25.0     # bp/s
G      = 18.5     # pN·nm
A      = 300.0    # pN·nm
phi    = 1/10.5

# TopoI (I) e gyrase (G) default
lambda_ns_I_def = 1e-4   # ns TopoI (/bp/s)
Lambda_s_I_def  = 1.0    # specific TopoI (/s)
lambda_ns_G_def = 1e-4   # ns Gyrase (/bp/s)
Lambda_s_G_def  = 2.0    # specific Gyrase (/s)

# Comprimentos de domínio upstream / downstream (situação de 1 RNAP)
D_up_def   = 1000.0   # tss padrão
D_down_def = L + Ld    # gene + downstream


def theoretical_T_elong_asym(row):
    # ajusta domínio upstream se for variação de tss
    D_up   = row.value if row.param=='tss'     else D_up_def
    D_down = D_down_def

    # sobrescreve parâmetros de TopoI/gyrase conforme variação
    lam_ns_I = row.value if row.param=='nstopo1' else lambda_ns_I_def
    Lam_s_I  = row.value if row.param=='stopo1'  else Lambda_s_I_def
    lam_ns_G = row.value if row.param=='nsgyrase'else lambda_ns_G_def
    Lam_s_G  = row.value if row.param=='sgyrase' else Lambda_s_G_def

    # taxas totais upstream / downstream
    lam_I = lam_ns_I * D_up   + Lam_s_I
    lam_G = 2 * (lam_ns_G * D_down + Lam_s_G)

    # taxa efetiva total
    lam0 = lam_I + lam_G

    # velocidade efetiva e tempo
    v_eff = v_max / (1 + (A * phi * v_max) / (G * lam0))
    T_elong = L / v_eff
    return T_elong

# calcula e adiciona coluna teórica
df['elong_time_theo'] = df.apply(theoretical_T_elong_asym, axis=1)

# mostra tabela comparativa
print(df[['param','value','elong_time_sim','elong_time_theo']].to_string(index=False))

# plota comparação
plt.figure(figsize=(10,5))
x = np.arange(len(df))
plt.plot(x, df['elong_time_sim'], 'o-', label='Simulação')
plt.plot(x, df['elong_time_theo'], 's--', label='Teórico assimétrico')
plt.xticks(x, [f"{p}:{v:.3g}" for p,v in zip(df.param,df.value)], rotation=45, ha='right')
plt.ylabel('Tempo de Elongação (s)')
plt.title('Comparação: Simulado vs Modelo Assimétrico')
plt.legend()
plt.tight_layout()
plt.show()
