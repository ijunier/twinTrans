# Build simulation DataFrame
sim_df = pd.DataFrame(sim_values, index=distances, columns=As).reset_index().melt(id_vars='index', var_name='A', value_name='T_sim')
sim_df.rename(columns={'index':'tss'}, inplace=True)

# Theoretical function using full domain
def theoretical_T_elong(L, v_max, G, A, tss, Ldown,
                        lambda_ns, Lambda_s,
                        lambda_ns_g, Lambda_s_g,
                        phi=1/10.5):
    D_dom = tss + L + Ldown
    lambda0 = (lambda_ns * D_dom + Lambda_s) + 2*(lambda_ns_g * D_dom + Lambda_s_g)
    v_eff = v_max / (1 + (A * phi * v_max) / (G * lambda0))
    return L / v_eff

# Default parameters
L = 520
Ldown = 520
v_max = 25
G = 18.5
lambda_ns = 1e-4
lambda_ns_g = 1e-4
Lambda_s = 1.0
Lambda_s_g = 2.0

# Compute theoretical values
sim_df['T_theo'] = sim_df.apply(
    lambda row: theoretical_T_elong(L, v_max, G,
                                    row['A'], row['tss'], Ldown,
                                    lambda_ns, Lambda_s,
                                    lambda_ns_g, Lambda_s_g),
    axis=1)

# Plot comparison
plt.figure(figsize=(10,6))
for A_val in As:
    subset = sim_df[sim_df['A']==A_val]
    plt.plot(subset['tss'], subset['T_sim'], marker='o', label=f'Sim A={A_val}')
    plt.plot(subset['tss'], subset['T_theo'], marker='s', linestyle='--', label=f'Theo A={A_val}')

plt.xscale('log')
plt.xlabel('Upstream Distance tss (bp)')
plt.ylabel('Mean Elongation Time (s)')
plt.title('Comparação: Simulação vs Teoria usando D_dom')
plt.legend(ncol=2, fontsize='small')
plt.grid(True, which='both', ls='--', lw=0.5)
plt.tight_layout()
plt.show()

