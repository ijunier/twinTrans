import math
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# ———————————————————
# 1) Dados de simulação
# ———————————————————
data = [
    ("kb",    0.010, 112.563088),
    ("kb",    0.453,  83.320568),
    ("kb",  100.000,  82.890564),
    ("ke",    0.010,  80.036460),
    ("ke",   10.000,  82.811432),
    ("ko",    0.010,  80.169580),
    ("ko",  100.000,  83.420148),
    ("nsgyrase",1e-6, 79.606184),
    ("nstopo1",1e-6,  90.890096),
    ("sgyrase",0.020,1251.418612),
    ("stopo1",0.010, 779.104032),
    ("tss",  100.000,109.763228),
    ("tss", 5000.000, 66.977648),
]
df = pd.DataFrame(data, columns=['param','value','elong_time_sim'])

# ———————————————————
# 2) Parâmetros padrão
# ———————————————————
gene_L      = 900.0     # comprimento do gene (bp)
gene_Ldown  = 520.0     # distância downstream (bp)
v_max       = 25.0      # bp/s
G           = 18.5      # pN·nm
phi         = 1/10.5
A_def       = 300.0     # pN·nm

lambda_ns_def   = 1e-4  # topoI ns (1/bp/s)
Lambda_s_def    = 1.0   # topoI s  (1/s)
lambda_ns_g_def = 1e-4  # gyrase ns
Lambda_s_g_def  = 2.0   # gyrase s

tss_def = 1000.0        # bp

# ———————————————————
# 3) Função combinada
# ———————————————————
def T_total_model(row):
    # 3.1) Domínio topológico
    tss      = row['value'] if row['param']=='tss' else tss_def
    L_dom    = tss + gene_L + gene_Ldown
    Lk0_dom  = L_dom / 10.5

    # 3.2) Parâmetros variantes
    A       = row['value'] if row['param']=='A' else A_def
    lam_ns  = row['value'] if row['param']=='nstopo1' else lambda_ns_def
    lam_ns_g= row['value'] if row['param']=='nsgyrase' else lambda_ns_g_def
    Lam_s   = row['value'] if row['param']=='stopo1'  else Lambda_s_def
    Lam_s_g = row['value'] if row['param']=='sgyrase' else Lambda_s_g_def

    # 3.3) Taxa mean-field
    #    λ₀ = topoI(upstream)+gyrase(up+down)
    lam0 = (lam_ns * L_dom + Lam_s) + 2*(lam_ns_g * L_dom + Lam_s_g)
    #    v_eff
    v_eff = v_max / (1 + (A * phi * v_max)/(G * lam0))

    # 3.4) Stalls explícitos
    sigma_stall = - G / A
    dx_stall    = abs(sigma_stall) * L_dom
    N_stalls    = gene_L / dx_stall
    n_ev        = math.ceil(Lk0_dom)
    k_rel       = lam0
    t_free      = gene_L / v_eff
    t_stall     = n_ev / k_rel

    return t_free + N_stalls * t_stall

# aplica
df['elong_time_theo'] = df.apply(T_total_model, axis=1)

# ———————————————————
# 4) Plots
# ———————————————————
x = np.arange(len(df))
plt.figure(figsize=(10,5))
plt.plot(x, df['elong_time_sim'], 'o-', label='Simulação',   lw=2)
plt.plot(x, df['elong_time_theo'],'s--',label='Teórico c/ MF+Stall', lw=2)
plt.xticks(x, [f"{p}:{v:.2g}" for p,v in zip(df.param,df.value)],
           rotation=45, ha='right')
plt.ylabel("Tempo de Elongação (s)")
plt.title("Simulação vs Modelo Combinado Mean-Field + Stalls")
plt.legend()
plt.grid(True, ls='--', alpha=0.5)
plt.tight_layout()
plt.show()
