#!/usr/bin/env python3
import numpy as np
from scipy.integrate import solve_ivp
import matplotlib.pyplot as plt

# ——————————————————————————————————————————
# Parâmetros
tss         = 500
excluded    = 30
rnap_xi     = tss - excluded/2         # 485 bp
Lk0_up0     = rnap_xi / 10.5           # ≈46.19
Lk0_domain  = (tss + 900 + 520) / 10.5 # ≈182.86

L_up0   = Lk0_up0                      # domínio upstream em Lk units
L_down0 = Lk0_domain - Lk0_up0         # domínio downstream em Lk units

# taxas elementares
lambda_ns   = 1e-4   # TopoI não‐específico (/Lk‐unit/s)
Lambda_s    = 1      # TopoI específico   (/s)
lambda_ns_g = 1e-4   # girase não‐específico (/Lk‐unit/s)
Lambda_s_g  = 2      # girase específico   (/s)

v_max       = 25.0   # bp/s
sigma_stall = -18.5/300.0
gene_length = 900.0  # bp
# ——————————————————————————————————————————

def rhs(t, y):
    σ_up, σ_down, x = y

    # domínios dinâmicos em Lk‐units
    L_up   = L_up0   + x/10.5
    L_down = L_down0 - x/10.5

    # relaxamento por topoI (1 volta) + girase (2 voltas)
    k_rel_up   = (lambda_ns   * L_up   + Lambda_s) \
               + 2*(lambda_ns_g * L_up   + Lambda_s_g)
    k_rel_down = (lambda_ns   * L_down + Lambda_s) \
               + 2*(lambda_ns_g * L_down + Lambda_s_g)

    # velocidade efetiva (zero se ultrapassar sigma_stall)
    v_eff = v_max * max(0.0, 1 - max(σ_up, σ_down)/abs(sigma_stall))

    # EDOs
    dσ_up   = v_eff / L_up   - k_rel_up   * σ_up
    dσ_down = v_eff / L_down - k_rel_down * σ_down
    dx      = v_eff

    return [dσ_up, dσ_down, dx]

def hit_terminal(t, y):
    return y[2] - gene_length
hit_terminal.terminal = True
hit_terminal.direction = 1

y0 = [0.0, 0.0, 0.0]  # σ_up(0)=σ_down(0)=0 ; x(0)=0

sol = solve_ivp(
    rhs,
    t_span=(0, 1e4),
    y0=y0,
    events=hit_terminal,
    max_step=1.0,
    atol=1e-6, rtol=1e-6
)

t   = sol.t
σ_up   = sol.y[0]
σ_down = sol.y[1]
x      = sol.y[2]
t_final = sol.t_events[0][0] if sol.t_events[0].size>0 else t[-1]
print(f"Mean elongation time (ODE model): {t_final:.3f} s")
v_eff_time = np.gradient(x, t)

# ——————————————————————————————————————————
# Plot
plt.figure(figsize=(10,4))
plt.subplot(1,2,1)
plt.plot(t, v_eff_time)
plt.xlabel("t (s)")
plt.ylabel("v_eff (bp/s)")
plt.title(f"v_eff — tempo total = {t_final:.1f}s")

plt.subplot(1,2,2)
plt.plot(t, σ_up,   label="σ_up")
plt.plot(t, σ_down, label="σ_down")
plt.xlabel("t (s)")
plt.ylabel("σ")
plt.legend()
plt.title("Trajetórias de superenrolamento")

plt.tight_layout()
plt.show()






