import numpy as np
import matplotlib.pyplot as plt

# === Dados reais da simulação ===
tss_array = np.array([100,200,250,300,500,1000,2000,3000,4000,5000,8000,10000,12000,14000,16000,18000,20000])
T_real_array = np.array([
    108.995808, 105.930240, 103.515472, 102.044444, 94.464468, 82.989236,
    75.767280, 70.988056, 68.822540, 67.034956, 62.073332, 59.406952,
    57.413964, 55.752504, 54.484696, 53.625760, 52.447332])

# === Parâmetros do sistema ===
gene_L = 900                # bp
gene_Ldown = 520            # bp
rnap_vm = 25.0              # bp/s
rnap_torque_stall = 18.5    # pN.nm
dna_A = 300.0               # pN.nm
topoI_lambda_ns = 1e-4      # per bp per s
topoI_Lambda_s = 1.0        # per s
gyrase_lambda_ns = 1e-4     # per bp per s
gyrase_Lambda_s = 2.0       # per s

def T_elong_closed(tss, 
                   L=gene_L, Ld=gene_Ldown, v_max=rnap_vm, 
                   G=rnap_torque_stall, A=dna_A, 
                   topo_ns=topoI_lambda_ns, topo_s=topoI_Lambda_s, 
                   gyr_ns=gyrase_lambda_ns, gyr_s=gyrase_Lambda_s):
    # Domínio total do acúmulo de sigma
    Ldom = tss + L + Ld              # [bp]
    Lk0_dom = Ldom / 10.5            # [Lk units]
    sigma_stall = -G / A             # Limite de stall
    
    # Taxa total de relaxamento (topo+girase, upstream+downstream)
    k_rel = (topo_ns*Ldom + topo_s) + 2*(gyr_ns*Ldom + gyr_s)   # [1/s]
    
    # Número de eventos de relaxamento necessários para liberar stall
    # Cada evento relaxa 1/Lk0_dom em sigma, então precisa chegar até sigma_stall
    n_ev = int(np.ceil(1 / (1/Lk0_dom)))  # = Lk0_dom (ou use ceil se quiser garantir o inteiro)
    # OU: n_ev = int(np.ceil(Lk0_dom))
    
    # Distância média livre até stall (antes de qualquer relaxamento)
    dx_stall = abs(sigma_stall) * Ldom   # [bp]
    N_stalls = L / dx_stall              # Quantos stalls em média?
    
    # Tempo livre total (RNAP em movimento)
    t_free = L / v_max                   # [s]
    
    # Tempo médio parado em cada stall
    t_stall = n_ev / k_rel               # [s]
    
    # Tempo total de elongação
    T_total = t_free + N_stalls * t_stall
    return T_total

# Calcula T_elong_closed para cada tss
T_markov = np.array([T_elong_closed(tss) for tss in tss_array])

# Plotando
plt.figure(figsize=(10,6))
plt.plot(tss_array, T_real_array, '--o', label='Simulação')
plt.plot(tss_array, T_markov, '-d', label='Fórmula fechada física/Markov')
plt.xscale('log')
plt.xlabel('tss (bp)')
plt.ylabel('Tempo médio de elongação (s)')
plt.title('Tempo médio de elongação: Simulação vs Fórmula fechada')
plt.legend()
plt.tight_layout()
plt.show()

# Para explorar diferenças (erro relativo)
plt.figure(figsize=(8,4))
rel_err = (T_markov - T_real_array) / T_real_array
plt.plot(tss_array, rel_err, 'o-', color='crimson')
plt.axhline(0, color='gray', lw=1, ls='--')
plt.xscale('log')
plt.xlabel('tss (bp)')
plt.ylabel('Erro relativo (Markov vs Simulação)')
plt.title('Erro relativo da fórmula fechada')
plt.tight_layout()
plt.show()

