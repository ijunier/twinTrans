import os
import pandas as pd
import matplotlib.pyplot as plt

# --- Configurações ---
root_dir = 'results_final_ko_100'          # Diretório raiz dos resultados
tss_choice = 'tss_100'                    # Escolha: 'tss_100', 'tss_1000', 'tss_5000'
default_gene_length = 3000.0              # nt, valor padrão se não extraído

records = []

# Varre diretórios de kb
for kb_dir in sorted(os.listdir(root_dir)):
    if not kb_dir.startswith('kb_'):
        continue
    kb_val = float(kb_dir.split('_')[1])
    kb_path = os.path.join(root_dir, kb_dir)

    # Seleciona o kun mínimo (quase sem unbinding)
    kun_dirs = [d for d in os.listdir(kb_path) if d.startswith('kun_')]
    if not kun_dirs:
        continue
    kun_dirs_sorted = sorted(
        [(d, float(d.split('_')[1])) for d in kun_dirs], key=lambda x: x[1]
    )
    kun_dir, kun_val = kun_dirs_sorted[0]
    sim_tss_path = os.path.join(kb_path, kun_dir, tss_choice)

    mean_file = os.path.join(sim_tss_path, 'mean_properties.txt')
    param_file = os.path.join(sim_tss_path, 'param_var.txt')
    if not os.path.isfile(mean_file) or not os.path.isfile(param_file):
        print(f"Ignorando {kb_dir}/{kun_dir}/{tss_choice}: arquivos não encontrados.")
        continue

    # Lê propriedades médias
    df = pd.read_csv(
        mean_file,
        sep=r"\s+",
        comment='#',
        header=None,
        names=[
            'transcripts_nb', 'time', 'prod_rate', 'mean_prod_time',
            'mean_bind_time', 'mean_ocf_time', 'mean_esc_time',
            'mean_init_time', 'mean_elong_time'
        ]
    )
    single = df[df['transcripts_nb'] == 1]
    if single.empty:
        print(f"Nenhum registro single-RNAP em {mean_file}.")
        continue
    mean_elong = single['mean_elong_time'].iloc[0]

    # Extrai comprimento do gene
    gene_length = None
    with open(param_file) as f:
        for line in f:
            if 'gene_length' in line or 'L_gene' in line:
                parts = line.strip().split('=')
                if len(parts) == 2:
                    try:
                        gene_length = float(parts[1])
                    except ValueError:
                        pass
                break
    if gene_length is None:
        gene_length = default_gene_length

    # Calcula r_miller
    r_miller = gene_length / mean_elong
    records.append({'kb': kb_val, 'r_miller': r_miller})

# Valida e plota
if not records:
    raise RuntimeError(
        'Nenhum dado encontrado. Verifique caminhos e nomes de pastas e tss_choice.'
    )

df_res = pd.DataFrame(records).sort_values('kb')
plt.figure(figsize=(4,3))
plt.bar(df_res['kb'].astype(str), df_res['r_miller'])
plt.xscale('log')
plt.xlabel('promoter_kb (proxy [IPTG])')
plt.ylabel('r_miller (nt/s)')
plt.title(f'Reprodução do painel 1C (tss = {tss_choice}, kun minimal)')
plt.tight_layout()
plt.show()

