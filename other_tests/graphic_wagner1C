import os
import pandas as pd
import matplotlib.pyplot as plt

# --- Configurações ---
root_dir = 'results_final_ko_100'
tss_choice = 'tss_1000'
default_gene_length = 900  # nt

records = []

for kb_dir in sorted(os.listdir(root_dir)):
    if not kb_dir.startswith('kb_'):
        continue
    kb_val    = float(kb_dir.split('_')[1])
    mean_file = os.path.join(root_dir, kb_dir, 'kun_0.070711', tss_choice, 'mean_properties.txt')
    param_file= os.path.join(root_dir, kb_dir, 'kun_0.070711', tss_choice, 'param_var.txt')

    if not os.path.isfile(mean_file):
        print(f"Ignorando {mean_file}")
        continue

    # --- Lê todas as linhas puramente numéricas ---
    data_lines = []
    with open(mean_file) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith('#'):
                continue
            parts = line.split()
            try:
                floats = [float(x) for x in parts]
            except ValueError:
                continue
            data_lines.append(floats)

    if not data_lines:
        print(f"Nenhum dado em {mean_file}")
        continue

    # 1) procurar especificamente transcripts_nb == 10000, se existir:
    target = None
    for floats in data_lines:
        if int(floats[0]) == 10000:
            target = floats
            break
    # 2) ou, se não encontrar exatamente 10000, pegar a última linha:
    if target is None:
        target = data_lines[-1]

    # Agora target é a linha desejada; prod_rate está em target[2], mean_elong em target[-1]
    mean_elong = float(target[-1])

    # --- Extrai gene_length ---
    gene_length = default_gene_length
    if os.path.isfile(param_file):
        with open(param_file) as f:
            for line in f:
                if 'gene_length' in line or 'L_gene' in line:
                    parts = line.strip().split('=')
                    if len(parts) == 2:
                        try:
                            gene_length = float(parts[1])
                        except:
                            pass
                    break

    # --- Calcula r_miller ---
    r_miller = gene_length / mean_elong
    records.append({'kb': kb_val, 'r_miller': r_miller})

# --- Monta DataFrame e plota ---
df_res = pd.DataFrame(records).sort_values('kb')

x = df_res['kb'].values
y = df_res['r_miller'].values

plt.figure(figsize=(4,3))
plt.bar(x, y, width=x*0.2)
plt.xscale('log')
plt.xticks(x, [f"{v:.3g}" for v in x], rotation=45)
plt.xlabel('promoter_kb (proxy para [IPTG])')
plt.ylabel('r$_{Miller}$ (nt/s)')
plt.title('Painel 1C, agora usando 10 000 transcritos')
plt.tight_layout()
plt.show()





