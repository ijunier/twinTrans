#!/usr/bin/env python3
import os, re, glob
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# ------------------ CONFIG ------------------
ROOT      = "results_final_kb_0.453"  # raiz mostrada no print
KO_TARGET = 0.238731                  # vamos usar esse ko (ou o mais próximo)
KB        = 0.453                     # kb do conjunto "médio"
KE        = 100.0                     # s^-1
L_GENE    = 900.0                     # bp
L_CLEAR   = 30.0                      # bp (rel no seu código)
TSS_LIST  = [100, 1000, 5000]

# P_OC(d) medidos para A=300 (da sua curva de repressão)
# (pegamos exatamente os 3 que vamos usar)
POC_BY_TSS = {
    100:  0.746,
    1000: 0.943,
    5000: 0.998,
}

# ------------------ HELPERS ------------------
def num_from_name(pat, text):
    m = re.search(rf"{pat}_([\d\.Ee+-]+)$", text)
    return float(m.group(1)) if m else None

def read_mp(fname):
    # tenta tab, depois whitespace
    try:
        df = pd.read_csv(fname, sep="\t")
    except Exception:
        df = pd.read_csv(fname, sep=r"\s+")
    # ordena por transcripts_nb para consistência
    if "transcripts_nb" in df.columns:
        df = df.sort_values("transcripts_nb")
    return df

def velocity_from_mp(df):
    """
    Usa a última linha (ou a de transcripts_nb==10000 se existir)
    para pegar mean_elong_time e devolver v = L_GENE / mean_elong_time.
    """
    if "mean_elong_time" not in df.columns:
        return np.nan
    # tenta pegar n=10000 se existir
    if "transcripts_nb" in df.columns and (df["transcripts_nb"] == 10000).any():
        row = df[df["transcripts_nb"] == 10000].iloc[-1]
    else:
        row = df.iloc[-1]
    T = float(row["mean_elong_time"])
    return L_GENE / T if T > 0 else np.nan

def nearest_folder(base, prefix, target):
    """
    Retorna o caminho do subdiretório de 'base' com prefixo 'prefix_'
    cujo valor numérico é o mais próximo de 'target'.
    """
    cands = []
    for d in glob.glob(os.path.join(base, f"{prefix}_*")):
        val = num_from_name(prefix, os.path.basename(d))
        if val is not None:
            cands.append((abs(val - target), val, d))
    if not cands:
        return None, None
    cands.sort()
    return cands[0][2], cands[0][1]

# ------------------ PICK ko ------------------
ko_dir, ko_val = nearest_folder(ROOT, "ko", KO_TARGET)
if ko_dir is None:
    raise FileNotFoundError(f"Nenhum diretório ko_* encontrado em {ROOT}")
print(f"Usando ko = {ko_val} em {ko_dir}")

# ------------------ COLETA v(k_un) ------------------
curves = {}   # tss -> (kun_array, v_array)
for kun_path in sorted(glob.glob(os.path.join(ko_dir, "kun_*")),
                       key=lambda p: num_from_name("kun", os.path.basename(p))):
    kun = num_from_name("kun", os.path.basename(kun_path))
    if kun is None: 
        continue
    for tss in TSS_LIST:
        mp = os.path.join(kun_path, f"tss_{tss}", "mean_properties.txt")
        if not os.path.isfile(mp):
            continue
        v = velocity_from_mp(read_mp(mp))
        if np.isnan(v):
            continue
        curves.setdefault(tss, []).append((kun, v))

# ordena por k_un
for tss in list(curves.keys()):
    arr = np.array(sorted(curves[tss], key=lambda kv: kv[0]), dtype=float)
    curves[tss] = (arr[:,0], arr[:,1])

# ------------------ ESTIMA k_c (teórico e empírico) ------------------
def kc_theory(tss, v_high):
    Poc = POC_BY_TSS.get(tss, np.nan)
    if np.isnan(Poc) or v_high <= 0:
        return np.nan
    Delta = (1/KB) + (1/(ko_val*Poc)) + (1/KE) + (L_CLEAR / v_high)
    return 1.0 / Delta

def kc_empirical(kun, vel, frac=0.9):
    """
    Empírico: primeiro k_un em que v cai abaixo de frac * v_max
    """
    if len(vel) == 0:
        return np.nan
    vmax = np.nanmax(vel)
    thr = frac * vmax
    for x, y in zip(kun, vel):
        if y <= thr:
            return x
    return np.nan

kc_th = {}
kc_em = {}
v_high = {}
for tss, (kun, vel) in curves.items():
    if len(kun) == 0:
        continue
    # v_high ~ valor com menor k_un disponível
    v_high[tss] = vel[0]
    kc_th[tss]  = kc_theory(tss, v_high[tss])
    kc_em[tss]  = kc_empirical(kun, vel, frac=0.90)

# ------------------ PLOT ------------------
plt.figure(figsize=(7,4.5))
colors = {100:"#1f77b4", 1000:"#ff7f0e", 5000:"#2ca02c"}
labels = {100:"TSS = 100 bp", 1000:"TSS = 1000 bp", 5000:"TSS = 5000 bp"}

for tss in TSS_LIST:
    if tss not in curves: 
        continue
    kun, vel = curves[tss]
    plt.plot(kun, vel, "o-", lw=1.8, ms=4, label=labels[tss], color=colors[tss])
    # linhas verticais: k_c empírico (ponto) e teórico (tracejado)
    if not np.isnan(kc_em.get(tss, np.nan)):
        plt.axvline(kc_em[tss], color=colors[tss], ls=":", lw=1.6,
                    label=f"k_c emp (TSS {tss}) ≈ {kc_em[tss]:.3g}")
    if not np.isnan(kc_th.get(tss, np.nan)):
        plt.axvline(kc_th[tss], color=colors[tss], ls="--", lw=1.6,
                    label=f"k_c teórico (TSS {tss}) ≈ {kc_th[tss]:.3g}")

plt.xscale("log")
plt.xlabel("k_unbinding (s$^{-1}$)")
plt.ylabel("Elongation velocity v (bp/s)")
plt.title(f"v × k_un (kb={KB}, ko≈{ko_val})\n"
          "Linhas: k_c empírico (:) e teórico (--)")
plt.grid(True, which="both", ls=":")
plt.legend(ncol=2, fontsize=9)
plt.tight_layout()
plt.show()

# --- (opcional) imprimir tabela com k_c e v_high usados ---
print("\nResumo k_c:")
for tss in TSS_LIST:
    if tss in curves:
        print(f"TSS {tss:4d}: v_high≈{v_high[tss]:6.2f}  "
              f"k_c(emp)≈{kc_em.get(tss, np.nan):.4g}  "
              f"k_c(th)≈{kc_th.get(tss, np.nan):.4g}")
