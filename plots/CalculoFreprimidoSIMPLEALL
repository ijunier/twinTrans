#!/usr/bin/env python3
import os
import sys

# Parâmetros gerais
sigma_o   = -0.05       # limiar de repressão (sigma > sigma_o)
t_start   = 100.0       # só conta a partir de t >= 100s
base_dir  = "results/promfollow"

# Lista de promotores e valores de tss a processar
prom_dirs  = ["A_200", "A_233", "A_267", "A_300", "A_333", "A_367"]
tss_values = [100, 200, 250, 300, 500, 1000, 2000, 3000, 4000, 5000, 8000, 10000, 12000, 14000, 16000, 18000, 20000]

# Cabeçalho da saída
print("promotor\ttss\ttotal_steps\trepressed_steps\tfraction")

for prom in prom_dirs:
    for tss in tss_values:
        # monta o caminho completo para o arquivo
        fn = os.path.join(base_dir, prom, f"tss_{tss}", "traj_promoter.txt")
        if not os.path.isfile(fn):
            print(f"Atenção: arquivo não encontrado: {fn}", file=sys.stderr)
            continue

        contador = 0
        total    = 0

        with open(fn) as f:
            next(f)  # pula cabeçalho
            for line in f:
                parts = line.strip().split()
                if len(parts) < 2:
                    continue
                time  = float(parts[0])
                sigma = float(parts[1])

                # ignora antes de t_start
                if time < t_start:
                    continue

                total += 1
                if sigma > sigma_o:
                    contador += 1

        # calcula fração e imprime
        fraction = contador / total if total > 0 else 0.0
        print(f"{prom}\t{tss}\t{total}\t{contador}\t{fraction:.2%}")
