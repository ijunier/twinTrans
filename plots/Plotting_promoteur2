#!/usr/bin/env python3
import os
import pandas as pd
import matplotlib.pyplot as plt

# === 1) CONFIGURATION ===
A = 300
distances = [100, 200, 250, 300, 500, 1000, 2000, 3000, 4000, 5000, 8000, 10000, 12000, 14000, 16000, 18000, 20000]
root       = "results/promfollow"
subdir_tss = "tss_{}"
traj_file  = "traj_promoter.txt"

# === 2) PLOT ALL σ(t) TOGETHER ===
plt.figure(figsize=(8,5))

for d in distances:
    fn = os.path.join(root, f"A_{A}", subdir_tss.format(d), traj_file)
    if not os.path.isfile(fn):
        print(f"Missing file: {fn}")
        continue

    df = pd.read_csv(fn, delim_whitespace=True)  # columns: time, sigma, t_upRNAPelong
    plt.plot(df["time"], df["sigma"], lw=1, label=f"d={d} bp")

plt.xlabel("Time (s)")
plt.ylabel("Promoter supercoiling σ")
plt.title(f"σ vs Time for A = {A} pN·nm\n(upstream distances overlayed)")
plt.legend(title="Upstream d", ncol=2, fontsize="small")
plt.grid(True, ls=":")
plt.tight_layout()
plt.show()
