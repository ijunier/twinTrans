import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# 1) Configuration: switch to medium promoter
promoter = "medium"
base_dir = "results/figure3B"
distances = [100, 200, 250, 300, 500, 1000, 2000, 3205,4000, 5000, 8000, 10000, 12000, 14000, 16000, 18000,20000]
target_transcripts = 10000

# 2) Load rates at exactly 10k transcripts
rates = {}
for d in distances:
    fn = os.path.join(base_dir, promoter, f"tss_{d}", "mean_properties.txt")
    if os.path.isfile(fn):
        df = pd.read_csv(fn, sep='\t')
        row = df[df['transcripts_nb'] == target_transcripts]
        rate = float(row['mean_elong_time']) if not row.empty else np.nan
    else:
        rate = np.nan
    rates[d] = rate

# 3) Compute susceptibility = rate(d) / rate(250)
rate_250 = rates[250]
sus = {d: rates[d] / rate_250 for d in distances}

# 4) Print out table
df = pd.DataFrame([
    {"Distance(bp)": d, "Prod_rate_10k": rates[d], "Susceptibility": sus[d]}
    for d in distances
])
print(df.to_string(index=False))

# 5) Plot
plt.figure(figsize=(6,4))
plt.plot(distances, [sus[d] for d in distances], marker='o', linestyle='-')
plt.xscale('log')
plt.xlabel("Upstream distance d (bp)")
plt.ylabel("Upstream susceptibility\n(rate(d) / rate(250))")
plt.title(f"Medium promoter susceptibility at {target_transcripts} transcripts")
plt.grid(True, which='both', linestyle=':')
plt.tight_layout()
plt.show()
