#!/usr/bin/env python3
import os
import pandas as pd
import matplotlib.pyplot as plt

# === 1) CONFIGURATION ===
base_dir    = "results/valores_k6"   # ajuste para a raiz onde estão k_*
k_values    = [0, 0.000001, 0.0001, 0.01, 0.08, 0.1, 0.12, 0.3, 0.5, 1]  # liste aqui os seus k_unbinding
distances   = [100, 200, 250, 300, 500, 700, 1000, 2000, 3000, 4000, 5000]
TARGET_N    = 10000

# === 2) READ & NORMALIZE PER k ===
sus_by_k = {}

# pre-calc index of 250 bp (normalização)
ref_idx = distances.index(250)

for k in k_values:
    rates = []

    # formata k com 6 casas decimais e remove zeros à direita / ponto final
    k_str = format(k, ".6f").rstrip("0").rstrip(".")
    # debug: confira se deu certo
    # print(f"procurando pasta k_{k_str} para k = {k}")

    for d in distances:
        fn = os.path.join(
            base_dir,
            f"k_{k_str}",       # usa a string limpa
            f"tss_{d}",
            "mean_properties.txt"
        )
        if not os.path.isfile(fn):
            raise FileNotFoundError(f"Não achei {fn}")
        df = pd.read_csv(fn, delim_whitespace=True)
        rate = df["prod_rate"].iloc[-1]
        rates.append(rate)

    # normaliza pelo valor em 250 bp
    ref = rates[ref_idx]
    sus_by_k[k] = [r / ref for r in rates]

# === 3) PLOT ALL TOGETHER ===
plt.figure(figsize=(8,5))
for k, sus in sus_by_k.items():
    plt.plot(distances, sus, marker='o', lw=2, label=f"k={k}")

plt.xscale('log')
plt.xlabel("Upstream distance d (bp)")
plt.ylabel("Susceptibility\n(rate(d)/rate(250))")
plt.title("Upstream Susceptibility vs Distance (normalized at 250 bp)")
plt.grid(True, which='both', ls=':')
plt.legend(title="k_unbinding")
plt.tight_layout()
plt.show()