#!/usr/bin/env python3
import os, math, subprocess, time
from pathlib import Path
from joblib import Parallel, delayed

# ======== CONFIG ========
OLD_ROOT = Path("results_final_ko_100")
NEW_ROOT = Path("results_ko100_topup_light")
TWIN     = Path("bin") / "twin.py"

# parâmetros fixos
ko_value = 100
so_value = -0.04
ke_value = 100
Ld_value = 520

# execução
n_jobs      = 48
Nt_quick    = 3000     # “tiro” rápido para bracketing
Nt_final    = 10000    # corrida final em k*
tss_list    = [1000]   # foque no Kim/Wagner (adicione [100,5000] se quiser)
kb_targets  = [
  1.0e-3, 2.0944e-2, 3.8483e-2, 7.0711e-2, 1.29926e-1,
  2.38731e-1, 4.38653e-1, 8.05997e-1, 1.480968, 2.721184, 5.0
]

# limites e política adaptativa
KMIN_HARD   = 1e-7    # não descer k_un abaixo disso
KMAX_HARD   = 300.0   # não subir k_un acima disso
GROW_FACTS  = (10.0, 100.0)   # quando todos N<1 -> tenta kmax*10, kmax*100
SHRINK_FACTS= (0.1, 0.01)     # quando todos N>1 -> tenta kmin*0.1, kmin*0.01
MAX_ROUNDS  = 4              # no máx quantas rodadas adaptativas

def fmt(x: float) -> str:
    return f"{x:.6g}"

def read_tail_N(mp_path: Path, tail=5) -> float | None:
    if not mp_path.exists(): return None
    rows=[]
    try:
        with open(mp_path, "r") as f:
            for ln in f:
                ln=ln.strip()
                if not ln or ln.startswith("#"): continue
                parts=ln.split()
                try:
                    vals=[float(x) for x in parts]
                except ValueError:
                    continue
                rows.append(vals)
        if not rows: return None
        tail_rows = rows[-tail:]
        prod_idx, elong_idx = 1, -1
        s=c=0
        for r in tail_rows:
            if len(r)<2: continue
            s += r[prod_idx]*r[elong_idx]; c+=1
        return float(s/c) if c else None
    except Exception:
        return None

def N_from_roots(kb: float, kun: float, tss: int) -> float | None:
    for root in (OLD_ROOT, NEW_ROOT):
        mp = root / f"kb_{fmt(kb)}" / f"kun_{fmt(kun)}" / f"tss_{tss}" / "mean_properties.txt"
        N = read_tail_N(mp)
        if N is not None: return N
    return None

def run_sim(kb: float, kun: float, tss: int, Nt: int) -> bool:
    outdir = NEW_ROOT / f"kb_{fmt(kb)}" / f"kun_{fmt(kun)}" / f"tss_{tss}"
    outdir.mkdir(parents=True, exist_ok=True)
    cmd = [
        "python3", str(TWIN), str(outdir),
        "-f",
        "-ko", str(ko_value), "-so", str(so_value),
        "-ke", str(ke_value), "-Ld", str(Ld_value),
        "-kb", fmt(kb), "-ku", fmt(kun), "-tss", str(tss),
        "-Nt", str(Nt),
    ]
    p = subprocess.run(cmd, capture_output=True, text=True)
    ok = (p.returncode == 0)
    tag=f"kb={fmt(kb):>8}  k_un={fmt(kun):>8}  tss={tss:<4}  Nt={Nt}"
    print(f"[{'OK' if ok else 'ERR'}] {tag}")
    if not ok: print(p.stderr)
    return ok

def collect_pairs(kb: float, tss: int):
    pairs=[]
    for root in (OLD_ROOT, NEW_ROOT):
        kb_dir = root / f"kb_{fmt(kb)}"
        if not kb_dir.exists(): continue
        for kd in kb_dir.glob("kun_*"):
            try: kun = float(kd.name.split("_")[1])
            except: continue
            N = N_from_roots(kb, kun, tss)
            if N is not None:
                pairs.append((kun,N))
    seen,out=set(),[]
    for k,N in sorted(pairs):
        key=(round(k,12), round(N,6))
        if key in seen: continue
        seen.add(key); out.append((k,N))
    return out

def bracket_info(pairs):
    below=[(k,N) for k,N in pairs if N<1.0]
    above=[(k,N) for k,N in pairs if N>1.0]
    if below and above:
        k1,N1=max(below, key=lambda p:p[1])  # maior N<1
        k2,N2=min(above, key=lambda p:p[1])  # menor N>1
        return True,(k1,N1,k2,N2)
    return False,None

def log_interp_kstar(k1,N1,k2,N2):
    x1,x2=math.log10(k1), math.log10(k2)
    x = x1 + (1.0-N1)*(x2-x1)/(N2-N1+1e-12)
    return 10**x

def schedule_new_shots(kb: float, tss: int, pairs):
    if not pairs:
        # seed inicial robusto
        return [1e-3, 1e-2, 0.1, 1.0]
    Nvals=[N for _,N in pairs]
    ks=[k for k,_ in pairs]
    k_existing={round(k,12) for k in ks}
    kmin,kmax=min(ks),max(ks)

    print(f"   · Diagnóstico: Nmin={min(Nvals):.3f}  Nmax={max(Nvals):.3f}   kmin={kmin:.6g}  kmax={kmax:.6g}")

    new=[]
    if max(Nvals)<1.0:
        # subir k_un agressivamente
        for f in GROW_FACTS:
            k = min(KMAX_HARD, kmax*f)
            if round(k,12) not in k_existing: new.append(k)
        print("   → todos N<1: novos k_un ↑:", ", ".join(fmt(x) for x in new) or "—")
        return new

    if min(Nvals)>1.0:
        # descer k_un agressivamente
        for f in SHRINK_FACTS:
            k = max(KMIN_HARD, kmin*f)
            if round(k,12) not in k_existing: new.append(k)
        print("   → todos N>1: novos k_un ↓:", ", ".join(fmt(x) for x in new) or "—")
        return new

    print("   → já existe N<1 e N>1: sem pass1 extra aqui.")
    return []

def do_round(kb_targets, tss_list, Nt_for_shots):
    jobs=[]
    for kb in kb_targets:
        for tss in tss_list:
            pairs=collect_pairs(kb,tss)
            have,_=bracket_info(pairs)
            if have:
                print(f"[INFO] kb={fmt(kb)} tss={tss}: já bracketado.")
                continue
            print(f"[PLAN] kb={fmt(kb)} tss={tss}: sem bracketing (len={len(pairs)}).")
            for kun in schedule_new_shots(kb,tss,pairs):
                mp = NEW_ROOT / f"kb_{fmt(kb)}" / f"kun_{fmt(kun)}" / f"tss_{tss}" / "mean_properties.txt"
                if not mp.exists():
                    jobs.append((kb,kun,tss,Nt_for_shots))
    if jobs:
        print(f"\n[PASS1] Rodando {len(jobs)} tiros (Nt={Nt_for_shots}) com n_jobs={n_jobs}...\n")
        Parallel(n_jobs=n_jobs)(
            delayed(run_sim)(kb,kun,tss,Nt_for_shots) for kb,kun,tss,_ in jobs
        )
    return jobs

def run_pass2(kb_targets, tss_list):
    jobs=[]
    for kb in kb_targets:
        for tss in tss_list:
            pairs=collect_pairs(kb,tss)
            have,info=bracket_info(pairs)
            if not have:
                print(f"[WARN] kb={fmt(kb)} tss={tss}: ainda sem bracketing (len={len(pairs)}).")
                continue
            k1,N1,k2,N2=info
            kstar=log_interp_kstar(k1,N1,k2,N2)
            mp = NEW_ROOT / f"kb_{fmt(kb)}" / f"kun_{fmt(kstar)}" / f"tss_{tss}" / "mean_properties.txt"
            if not mp.exists():
                jobs.append((kb,kstar,tss,Nt_final))
            print(f"[INFO] kb={fmt(kb)} tss={tss} → k*≈{kstar:.6g} (de {k1:.6g}→{k2:.6g})")
    if jobs:
        print(f"\n[PASS2] Rodando {len(jobs)} corridas finais (Nt={Nt_final}) com n_jobs={n_jobs}...\n")
        Parallel(n_jobs=n_jobs)(
            delayed(run_sim)(kb,kun,tss,Nt_final) for kb,kun,tss,_ in jobs
        )
    else:
        print("\n[PASS2] Nada a rodar.")
    return jobs

# =============== MAIN ===============
if __name__=="__main__":
    NEW_ROOT.mkdir(parents=True, exist_ok=True)

    # várias rodadas adaptativas até bracketar (ou atingir limites)
    for r in range(1, MAX_ROUNDS+1):
        print(f"\n===== RODADA {r}/{MAX_ROUNDS} — busca adaptativa por bracketing =====")
        jobs = do_round(kb_targets, tss_list, Nt_quick)
        if not jobs:
            print("[INFO] Rodada sem novos tiros; talvez já esteja bracketado em tudo.")
        # tenta PASS2 toda rodada (se já bracketou em algum kb)
        _ = run_pass2(kb_targets, tss_list)

    print("\n[OK] Top-up adaptativo finalizado. Resultados em:", NEW_ROOT)



