#!/usr/bin/env python3
import os, math, subprocess
from pathlib import Path
from joblib import Parallel, delayed

# ===================== CONFIG =====================
OLD_ROOT = Path("results_final_ko_100")          # resultados já existentes
NEW_ROOT = Path("results_ko100_topup_light")     # pasta nova para os "top-ups"
TWIN     = Path("bin") / "twin.py"

# parâmetros fixos do seu modelo
ko_value = 100
so_value = -0.04
ke_value = 100
Ld_value = 520

# execução
n_jobs      = 48
Nt_quick    = 3000      # “tiros” para bracketing
Nt_final    = 10000     # corrida final em k*
tss_list    = [1000]    # foco Kim/Wagner (adicione 100/5000 se quiser)

# k_b que faltavam bracketing na sua tabela
kb_targets = [
  1.0e-3, 2.0944e-2, 3.8483e-2, 7.0711e-2, 1.29926e-1,
  2.38731e-1, 4.38653e-1, 8.05997e-1, 1.480968, 2.721184, 5.0
]

# ======== helpers ========
def fmt(x: float) -> str:
    return f"{x:.6g}"

def read_tail_N(mp_path: Path, tail=5) -> float | None:
    """Lê tail do mean_properties.txt e retorna <prod_rate*mean_elong_time> (N_elon)."""
    if not mp_path.exists(): return None
    try:
        rows = []
        with open(mp_path, "r") as f:
            for ln in f:
                ln = ln.strip()
                if not ln or ln.startswith("#"):  # pula comentários
                    continue
                parts = ln.split()
                try:
                    vals = [float(x) for x in parts]
                except ValueError:
                    # header textual — ignoramos (fallback nos índices numéricos abaixo)
                    continue
                rows.append(vals)
        if not rows:
            return None
        tail_rows = rows[-tail:]
        # fallback de índices: [transcripts_nb, prod_rate, ..., mean_elong_time]
        prod_idx  = 1
        elong_idx = -1
        s = 0.0; c = 0
        for r in tail_rows:
            if len(r) < 2:  # linha curta
                continue
            pr = r[prod_idx]
            mt = r[elong_idx]
            s += pr*mt; c += 1
        if c == 0: return None
        return float(s/c)
    except Exception:
        return None

def N_from_roots(kb: float, kun: float, tss: int) -> float | None:
    for root in (OLD_ROOT, NEW_ROOT):
        mp = root / f"kb_{fmt(kb)}" / f"kun_{fmt(kun)}" / f"tss_{tss}" / "mean_properties.txt"
        N = read_tail_N(mp)
        if N is not None: return N
    return None

def run_sim(kb: float, kun: float, tss: int, Nt: int) -> bool:
    outdir = NEW_ROOT / f"kb_{fmt(kb)}" / f"kun_{fmt(kun)}" / f"tss_{tss}"
    outdir.mkdir(parents=True, exist_ok=True)
    cmd = [
        "python3", str(TWIN), str(outdir),
        "-f",
        "-ko", str(ko_value), "-so", str(so_value),
        "-ke", str(ke_value), "-Ld", str(Ld_value),
        "-kb", fmt(kb), "-ku", fmt(kun), "-tss", str(tss),
        "-Nt", str(Nt),
    ]
    p = subprocess.run(cmd, capture_output=True, text=True)
    ok = (p.returncode == 0)
    tag = f"kb={fmt(kb):>8}  k_un={fmt(kun):>8}  tss={tss:<4}  Nt={Nt}"
    print(f"[{'OK' if ok else 'ERR'}] {tag}")
    if not ok: print(p.stderr)
    return ok

def collect_pairs(kb: float, tss: int):
    """Coleta (k_un, N) existentes em OLD_ROOT e NEW_ROOT, sem duplicatas."""
    pairs = []
    for root in (OLD_ROOT, NEW_ROOT):
        kb_dir = root / f"kb_{fmt(kb)}"
        if not kb_dir.exists(): continue
        for kd in kb_dir.glob("kun_*"):
            try: kun = float(kd.name.split("_")[1])
            except: continue
            N = N_from_roots(kb, kun, tss)
            if N is not None:
                pairs.append((kun, N))
    # únicos, ordenados por k
    seen, out = set(), []
    for k,N in sorted(pairs):
        key = (round(k, 12), round(N, 6))
        if key in seen: continue
        seen.add(key); out.append((k,N))
    return out

def bracket_info(pairs):
    """Retorna (True,(k1,N1,k2,N2)) se já tem N<1 e N>1; senão (False,None)."""
    below = [(k,N) for k,N in pairs if N < 1.0]
    above = [(k,N) for k,N in pairs if N > 1.0]
    if below and above:
        k1,N1 = max(below, key=lambda p: p[1])  # maior N<1
        k2,N2 = min(above, key=lambda p: p[1])  # menor N>1
        return True, (k1,N1,k2,N2)
    return False, None

def log_interp_kstar(k1,N1,k2,N2):
    x1, x2 = math.log10(k1), math.log10(k2)
    x = x1 + (1.0 - N1) * (x2 - x1) / (N2 - N1 + 1e-12)
    return 10**x

def plan_new_kuns(kb: float, tss: int, pairs):
    """Escolhe novos k_un quando não há bracketing; retorna lista de novos k_un."""
    if not pairs:
        # ponto de partida bem espalhado
        return [1e-3, 1e-2, 0.1, 1.0]

    Nvals = [N for _,N in pairs]
    ks    = [k for k,_ in pairs]
    k_existing = {round(k,12) for k in ks}
    kmin, kmax  = min(ks), max(ks)

    # DIAGNÓSTICO
    print(f"   · Nmin={min(Nvals):.3f}  Nmax={max(Nvals):.3f}   kmin={kmin:.6g}  kmax={kmax:.6g}")

    new = []
    if max(Nvals) < 1.0:
        # precisamos SUBIR k_un além do que você já tem
        hi1 = max(10.0, 2.0*kmax)
        hi2 = max(20.0, 5.0*kmax)
        for k in (hi1, hi2):
            if round(k,12) not in k_existing:
                new.append(k)
        print(f"   → todos N<1: agendando acima: {', '.join(fmt(x) for x in new) or '—'}")
        return new

    if min(Nvals) > 1.0:
        # precisamos DESCER k_un abaixo do mínimo atual (que era 0.001)
        low1 = min(1e-4, kmin/4.0)
        low2 = min(3e-5, kmin/10.0)
        for k in (low1, low2):
            if round(k,12) not in k_existing:
                new.append(k)
        print(f"   → todos N>1: agendando abaixo: {', '.join(fmt(x) for x in new) or '—'}")
        return new

    # já há pontos dos dois lados → nada na pass1
    print("   → já há N<1 e N>1: sem novos tiros na pass1.")
    return []

# ===================== agendamento =====================
def schedule_pass1(kb_targets, tss_list):
    jobs = []
    for kb in kb_targets:
        for tss in tss_list:
            pairs = collect_pairs(kb, tss)
            have, _ = bracket_info(pairs)
            if have:
                print(f"[INFO] kb={fmt(kb)} tss={tss}: já tem bracketing.")
                continue
            print(f"[PLAN] kb={fmt(kb)} tss={tss}: sem bracketing (len={len(pairs)})")
            for kun in plan_new_kuns(kb, tss, pairs):
                mp = NEW_ROOT / f"kb_{fmt(kb)}" / f"kun_{fmt(kun)}" / f"tss_{tss}" / "mean_properties.txt"
                if not mp.exists():
                    jobs.append((kb, kun, tss, Nt_quick))
    return jobs

def schedule_pass2(kb_targets, tss_list):
    jobs = []
    for kb in kb_targets:
        for tss in tss_list:
            pairs = collect_pairs(kb, tss)
            have, info = bracket_info(pairs)
            if not have:
                print(f"[WARN] kb={fmt(kb)} tss={tss}: ainda sem bracketing (len={len(pairs)}).")
                continue
            k1,N1,k2,N2 = info
            kstar = log_interp_kstar(k1,N1,k2,N2)
            mp = NEW_ROOT / f"kb_{fmt(kb)}" / f"kun_{fmt(kstar)}" / f"tss_{tss}" / "mean_properties.txt"
            if not mp.exists():
                jobs.append((kb, kstar, tss, Nt_final))
            print(f"[INFO] kb={fmt(kb)} tss={tss} → k*≈{kstar:.6g} (de {k1:.6g}→{k2:.6g})")
    return jobs

# ===================== main =====================
if __name__ == "__main__":
    NEW_ROOT.mkdir(parents=True, exist_ok=True)

    # PASSADA 1
    jobs1 = schedule_pass1(kb_targets, tss_list)
    if jobs1:
        print(f"\n[PASS1] Rodando {len(jobs1)} tiros (Nt={Nt_quick}) com n_jobs={n_jobs}...\n")
        Parallel(n_jobs=n_jobs)(
            delayed(run_sim)(kb,kun,tss,Nt) for (kb,kun,tss,Nt) in jobs1
        )
    else:
        print("\n[PASS1] Nada a rodar — já havia bracketing em tudo.\n")

    # PASSADA 2
    jobs2 = schedule_pass2(kb_targets, tss_list)
    if jobs2:
        print(f"\n[PASS2] Rodando {len(jobs2)} corridas finais (Nt={Nt_final}) com n_jobs={n_jobs}...\n")
        Parallel(n_jobs=n_jobs)(
            delayed(run_sim)(kb,kun,tss,Nt) for (kb,kun,tss,Nt) in jobs2
        )
    else:
        print("\n[PASS2] Nada a rodar.\n")

    print("\n[OK] Top-up finalizado. Resultados em:", NEW_ROOT)


