#!/usr/bin/env python3
from pathlib import Path
import numpy as np
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

ROOT = Path("results_final_kb_100")
GENE_LEN = 900.0

# Lê os dados
dados = []
for ko_dir in sorted(ROOT.glob("ko_*")):
    ko = float(ko_dir.name.split("_")[1])
    for kun_dir in sorted(ko_dir.glob("kun_*")):
        kun = float(kun_dir.name.split("_")[1])
        for tss_dir in sorted(kun_dir.glob("tss_*")):
            tss = int(tss_dir.name.split("_")[1])
            df = pd.read_csv(tss_dir / "mean_properties.txt", sep=r"\s+")
            if "transcripts_nb" in df.columns:
                i = df["transcripts_nb"].idxmax()
                temps = df.at[i, "mean_elong_time"]
            else:
                temps = df["mean_elong_time"].iloc[-1]
            vel = GENE_LEN / temps
            dados.append({"k_o": ko, "k_unbinding": kun, "tss": tss, "vel": vel})

df = pd.DataFrame(dados)
df = df[(df["k_o"] > 0) & (df["k_unbinding"] > 0)]

# Gráfico
sns.set(style="whitegrid", font_scale=1.1)
plt.rcParams["font.family"] = "DejaVu Sans"

tss_list = sorted(df["tss"].unique())
fig, axs = plt.subplots(1, len(tss_list), figsize=(5 * len(tss_list), 4),
                        sharex=True, sharey=True)

vmin, vmax = df["vel"].min(), df["vel"].max()
ticks = np.linspace(vmin, vmax, 8)

for ax, tss in zip(axs, tss_list):
    sub = df[df["tss"] == tss].copy()
    tabela = sub.pivot(index="k_o", columns="k_unbinding", values="vel")

    sns.heatmap(
        tabela, ax=ax, cmap="viridis",
        vmin=vmin, vmax=vmax,
        cbar=(ax == axs[-1]),
        cbar_kws={"label": "Velocity (pb/s)", "ticks": ticks},
        xticklabels=[f"{x:.1e}" for x in tabela.columns],
        yticklabels=[f"{y:.1e}" for y in tabela.index]
    )
    ax.set_title(f"TSS = {tss} bp")
    ax.set_xlabel("k_unbinding (1/s)")

axs[0].set_ylabel("k_o (1/s)")

plt.suptitle("Heatmap of the elongation velocity\n", y=1.02, fontsize=14)
plt.tight_layout(rect=[0, 0, 1, 0.95])
plt.show()









